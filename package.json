{
  "name": "dial-desktop",
  "version": "0.1.6",
  "description": "DIAL — local Windows workspace for forms, media and files",
  "author": "Esteban Nicola",
  "homepage": "https://estebanico.com",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build && electron-builder --dir --win --publish never",
    "test": "node --test"
  },
  "overrides": {
    "sprintf-js": "^1.1.3",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "org.dial.windows",
    "productName": "DIAL",
    "copyright": "Copyright © 2026 Esteban Nicola",
    "publish": [
      {
        "provider": "github",
        "owner": "estebanico10",
        "repo": "dial-desktop",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/sharp/**"
    ],
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/media.cjs",
      "electron/repository.cjs",
      "dist/**",
      "node_modules/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "COPYING",
        "to": "COPYING"
      },
      {
        "from": "UPSTREAM-NOTICE.md",
        "to": "UPSTREAM-NOTICE.md"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
